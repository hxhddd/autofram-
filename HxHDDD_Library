function HxHDDD:SaveConfig(configName, dataTable)
    configName = configName or "Default"
    local path = HxHDDD.ConfigFolder .. "/" .. configName .. ".json"
    local jsonStr = HttpService:JSONEncode(dataTable or {})
    writefile(path, jsonStr)
    HxHDDD:Notify("HxHDDD System", "บันทึก Config: " .. configName .. " เรียบร้อย!", 3)
end

function HxHDDD:LoadConfig(configName)
    configName = configName or "Default"
    local path = HxHDDD.ConfigFolder .. "/" .. configName .. ".json"
    if isfile(path) then
        local jsonStr = readfile(path)
        local data = HttpService:JSONDecode(jsonStr)
        HxHDDD:Notify("HxHDDD System", "โหลด Config: " .. configName .. " สำเร็จ!", 3)
        return data
    else
        HxHDDD:Notify("HxHDDD System", "ไม่พบไฟล์ Config: " .. configName, 3)
        return nil
    end
end

