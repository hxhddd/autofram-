    -- Add3DViewer (โชว์โมเดล 3D หมุนได้ 360 องศา)
    function Elements:Add3DViewer(viewerTitle, targetModel, options)
        options = options or {}
        local autoRotate = options.AutoRotate ~= false
        local cameraDistance = options.Distance or 5

        local ViewContainer = Instance.new("Frame")
        ViewContainer.Size = UDim2.new(1, 0, 0, 160)
        ViewContainer.BackgroundColor3 = HxHDDD.Themes.Secondary
        ViewContainer.BackgroundTransparency = 0.3
        ViewContainer.Parent = TabPage

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 8)
        Corner.Parent = ViewContainer

        local Title = Instance.new("TextLabel")
        Title.Size = UDim2.new(1, -10, 0, 20)
        Title.Position = UDim2.new(0, 8, 0, 4)
        Title.Text = "🧊 " .. viewerTitle
        Title.TextColor3 = HxHDDD.Themes.Accent
        Title.Font = Enum.Font.SourceSansBold
        Title.TextSize = 14
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.BackgroundTransparency = 1
        Title.Parent = ViewContainer

        local Viewport = Instance.new("ViewportFrame")
        Viewport.Size = UDim2.new(1, -16, 1, -30)
        Viewport.Position = UDim2.new(0, 8, 0, 24)
        Viewport.BackgroundTransparency = 1
        Viewport.Parent = ViewContainer

        local Camera = Instance.new("Camera")
        Viewport.CurrentCamera = Camera
        Camera.Parent = Viewport

        if targetModel then
            local modelClone = targetModel:Clone()
            modelClone.Parent = Viewport

            local primary = modelClone.PrimaryPart or modelClone:FindFirstChildWhichIsA("BasePart")
            if primary then
                local cf, size = modelClone:GetBoundingBox()
                local angle = 0

                RunService.RenderStepped:Connect(function(dt)
                    if Viewport.Visible and autoRotate then
                        angle = angle + dt * 45
                        local rotCF = CFrame.Angles(0, math.rad(angle), 0)
                        Camera.CFrame = CFrame.new(cf.Position) * rotCF * CFrame.new(0, 0, size.Y + cameraDistance)
                        Camera.Focus = cf
                    end
                end)
            end
        end
    end

    -- AddCharacterPreview (โชว์โมเดลตัวละครผู้เล่นปัจจุบัน)
    function Elements:AddCharacterPreview(previewTitle)
        previewTitle = previewTitle or "Character Preview"
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        Elements:Add3DViewer(previewTitle, char, {AutoRotate = true, Distance = 3.5})
    end

