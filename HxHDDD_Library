function HxHDDD:CreateWindow(hubTitle, hubVer)
    hubTitle = hubTitle or "HxHDDD Library"
    hubVer = hubVer or "v2.0"
    
    -- Main Frame รองรับจอมือถือ ไม่ใหญ่เกินขอบจอ
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 520, 0, 340)
    MainFrame.Position = UDim2.new(0.5, -260, 0.5, -170)
    MainFrame.BackgroundColor3 = HxHDDD.Themes.Main
    MainFrame.BackgroundTransparency = HxHDDD.Themes.Transparency
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui
    
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 12)
    UICorner.Parent = MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = HxHDDD.Themes.Outline
    MainStroke.Thickness = 1
    MainStroke.Parent = MainFrame
    
    -- Header Bar ด้านบน
    local TopBar = Instance.new("Frame")
    TopBar.Name = "TopBar"
    TopBar.Size = UDim2.new(1, 0, 0, 40)
    TopBar.BackgroundColor3 = HxHDDD.Themes.Secondary
    TopBar.BackgroundTransparency = 0.3
    TopBar.Parent = MainFrame
    
    local TopCorner = Instance.new("UICorner")
    TopCorner.CornerRadius = UDim.new(0, 12)
    TopCorner.Parent = TopBar
    
    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(0, 350, 1, 0)
    TitleLabel.Position = UDim2.new(0, 15, 0, 0)
    TitleLabel.Text = "💎 " .. hubTitle .. " | " .. hubVer .. " (By.HxHDDD)"
    TitleLabel.TextColor3 = HxHDDD.Themes.Text
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Font = Enum.Font.SourceSansBold
    TitleLabel.TextSize = 16
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Parent = TopBar

    -- ลอจิกกดปุ่มลอยเพื่อเปิด/ปิด UI
    FloatBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    -- ลอจิกลากเคลื่อนย้ายรองรับ Touch บนมือถือ
    local dragging, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)
    TopBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Size = UDim2.new(0, 130, 1, -40)
    Sidebar.Position = UDim2.new(0, 0, 0, 40)
    Sidebar.BackgroundColor3 = HxHDDD.Themes.Secondary
    Sidebar.BackgroundTransparency = 0.4
    Sidebar.Parent = MainFrame

    local TabContainer = Instance.new("ScrollingFrame")
    TabContainer.Name = "TabContainer"
    TabContainer.Size = UDim2.new(1, 0, 1, -45)
    TabContainer.BackgroundTransparency = 1
    TabContainer.ScrollBarThickness = 2
    TabContainer.Parent = Sidebar

    local TabUIList = Instance.new("UIListLayout")
    TabUIList.SortOrder = Enum.SortOrder.LayoutOrder
    TabUIList.Padding = UDim.new(0, 4)
    TabUIList.Parent = TabContainer

    local ContentContainer = Instance.new("Frame")
    ContentContainer.Name = "ContentContainer"
    ContentContainer.Size = UDim2.new(1, -135, 1, -40)
    ContentContainer.Position = UDim2.new(0, 135, 0, 40)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = MainFrame

    -- ตัวแปรสากลเชื่อมต่อ Logic หลังบ้าน
    _G.HxHDDD_Window = MainFrame
    _G.HxHDDD_TabContainer = TabContainer
    _G.HxHDDD_ContentContainer = ContentContainer

    HxHDDD:BuildSettingButton(Sidebar, ContentContainer)

    return MainFrame
end
