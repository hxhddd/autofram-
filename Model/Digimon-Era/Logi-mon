-- [[ 🛑 โซนที่ 1.2: ตรรกะการกวาดหาวัตถุในโฟลเดอร์ตัวเลขทั้งหมด 🛑 ]]

local function findPromptDynamic(objectName, subPath)
    local gameMap = workspace:FindFirstChild("GameMap")
    if not gameMap then return nil end
    
    -- วนลูปกวาดเช็คทุก Folder/Model ที่อยู่ภายใต้ GameMap (เช่น "12_11", "11_9" เป็นต้น)
    for _, zoneFolder in ipairs(gameMap:GetChildren()) do
        local mainObj = zoneFolder:FindFirstChild(objectName)
        if mainObj then
            -- เมื่อเจอ Object เป้าหมายแล้ว ให้วิ่งเจาะตาม subPath ลงไปหา ProximityPrompt
            local prompt = mainObj
            for segment in string.gmatch(subPath, "[^%.]+") do
                prompt = prompt and prompt:FindFirstChild(segment)
            end
            
            -- ถ้าแกะ Path สำเร็จและวัตถุนั้นมีอยู่จริง ให้ส่งค่ากลับไปทำงานทันที
            if prompt then
                return prompt
            end
        end
    end
    return nil
end


-- [[ 🛑 โซนที่ 2: ปรับแต่งปุ่มสวิตช์ควบคุม (Toggle Loop) ร่วมกับ Fluent UI 🛑 ]]

local MainTab = Tabs and Tabs.Main or _G.Tabs and _G.Tabs.Main

if MainTab then
    -- 1. สวิตช์ลูปฟาร์ม Dark Tower (กวาดหาทุกโฟลเดอร์)
    MainTab:AddToggle("DarkTowerLoop", {
        Title = "Auto Farm: Dark Tower",
        Default = false,
        Callback = function(Value)
            Flags.DarkTower = Value
            task.spawn(function()
                while Flags.DarkTower do
                    -- ใช้ฟังก์ชันไดนามิกในการสแกนหาแทนการล็อกชื่อโฟลเดอร์
                    local prompt = findPromptDynamic("Dark Tower", "TriggerPart.ProximityPrompt")
                    if prompt then 
                        interactWithPrompt(prompt) 
                    else 
                        task.wait(0.5) 
                    end
                    task.wait(0.1)
                end
            end)
        end
    })

