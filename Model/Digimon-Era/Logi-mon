-- [[ 🛑 โซนที่ 1: ตรรกะฟังก์ชันวาร์ปและสแกนไดนามิก (รองรับพิกัดติดลบ + ยิงรีโมท + เช็คของหาย) 🛑 ]]

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ฟังก์ชันยิงกด ProximityPrompt แบบรีโมทประชิด (เร่งความเร็ว + เช็คของหาย)
local function interactWithPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then return end
    
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local targetPart = prompt.Parent:IsA("Model") and prompt.Parent.PrimaryPart or prompt.Parent
    
    if targetPart and targetPart:IsA("BasePart") then
        -- 1. วาร์ปตัวละครเข้าประชิดพิกัดเพื่อให้ตำแหน่งฝั่งเซิร์ฟเวอร์อัปเดตทัน
        rootPart.CFrame = targetPart.CFrame * CFrame.new(0, 2, 0)
        task.wait(0.15) -- ดีเลย์จังหวะแรกให้ตัวละครเสถียรบนพิกัดฉากใหม่
        
        -- ตรวจสอบซ้ำอีกรอบเผื่อของโดนแย่งเก็บไปก่อนหน้าหน้าจังหวะนี้
        if not prompt or not prompt.Parent then return end
        
        -- 2. สั่งยิงคำสั่งกดแบบ Remote ทันที (เร่งความเร็วข้ามแอนิเมชันสำหรับมือถือ)
        pcall(function()
            fireproximityprompt(prompt, 0)
        end)
        
        -- 3. ลูปรอเช็คสถานะจนกว่าวัตถุจะสลายหายไปจริง (สูงสุดไม่เกิน 0.3 วินาที กันบอทติดบั๊กค้างคาที่)
        local timeOut = 0
        while prompt and prompt.Parent and timeOut < 0.3 do
            task.wait(0.05)
            timeOut = timeOut + 0.05
        end
        
        -- ดีเลย์สั้นๆ 0.05 วินาทีหลังของหาย เพื่อเตรียมพร้อมสลับจุดวาร์ปต่อไปแบบสมูท
        task.wait(0.05)
    end
end

-- ฟังก์ชันกวาดหาวัตถุแบบไดนามิก: รองรับชื่อโฟลเดอร์พิกัดที่เป็นเลขติดลบทุกรูปแบบ (เช่น -4_-5, -12_-18, 8_-12)
local function findPromptDynamic(objectName, subPath)
    local gameMap = workspace:FindFirstChild("GameMap")
    if not gameMap then return nil end
    
    -- กวาดเช็คทุก Folder/Model ใน GameMap โดยไม่สนใจว่าชื่อจะเป็นพิกัดเลขบวกหรือเลขลบ
    for _, zoneFolder in ipairs(gameMap:GetChildren()) do
        local mainObj = zoneFolder:FindFirstChild(objectName)
        if mainObj then
            -- แกะสลัก Path ลงไปหาพิกัด ProximityPrompt โดยรองรับอักขระพิเศษและเว้นวรรคได้ร้อยเปอร์เซ็นต์
            local prompt = mainObj
            for segment in string.gmatch(subPath, "[^%.]+") do
                if prompt then
                    prompt = prompt:FindFirstChild(segment)
                else
                    break
                end
            end
            
            -- ตรวจสอบความสมบูรณ์ก่อนส่งค่าไปใช้งาน
            if prompt and prompt:IsA("ProximityPrompt") and prompt.Parent then
                return prompt
            end
        end
    end
    return nil
end

-- ตัวแปรเก็บสถานะการเปิด-ปิดลูปของแต่ละหัวข้อ (ครบถ้วนทั้ง 4 ฟังก์ชัน)
local Flags = {
    DarkTower = false,
    StandardTreasure = false,
    Carrot = false,
    RoyalTreasure = false
}


-- [[ 🛑 โซนที่ 1.9: วนลูปรอจนกว่าหน้าต่าง UI หน้าบ้านจะโหลดเซ็ตค่าเสร็จ 🛑 ]]
repeat task.wait(0.5) until _G.HxHDDD_MainTab
local MainTab = _G.HxHDDD_MainTab


-- [[ 🛑 โซนที่ 2: โครงสร้างการสร้างปุ่ม Toggle ลูปอัตโนมัติ ทั้ง 4 ปุ่ม ร่วมกับ Fuel UI 🛑 ]]
if MainTab then
    -- 1. สวิตช์ลูปฟาร์ม Dark Tower
    MainTab:AddToggle("DarkTowerLoop", {
        Title = "Auto Farm: Dark Tower",
        Default = false,
        Callback = function(Value)
            Flags.DarkTower = Value
            task.spawn(function()
                while Flags.DarkTower do
                    local prompt = findPromptDynamic("Dark Tower", "TriggerPart.ProximityPrompt")
                    if prompt then 
                        interactWithPrompt(prompt) 
                    else 
                        task.wait(0.3) -- ถ้าของยังไม่เกิดใหม่ ให้หยุดพักสแกนสั้นๆ กันบอทรันถี่เกินไป
                    end
                    task.wait(0.05)
                end
            end)
        end
    })

    -- 2. สวิตช์ลูปฟาร์ม Standard Treasure
    MainTab:AddToggle("StandardTreasureLoop", {
        Title = "Auto Farm: Standard Treasure",
        Default = false,
        Callback = function(Value)
            Flags.StandardTreasure = Value
            task.spawn(function()
                while Flags.StandardTreasure do
                    local prompt = findPromptDynamic("Ruins1", "Standard Treasure.ProximityPrompt")
                    if prompt then 
                        interactWithPrompt(prompt) 
                    else 
                        task.wait(0.3) 
                    end
                    task.wait(0.05)
                end
            end)
        end
    })

    -- 3. สวิตช์ลูปฟาร์ม Carrot
    MainTab:AddToggle("CarrotLoop", {
        Title = "Auto Farm: Carrot",
        Default = false,
        Callback = function(Value)
            Flags.Carrot = Value
            task.spawn(function()
                while Flags.Carrot do
                    local prompt = findPromptDynamic("Carrot", "Carrot.ProximityPrompt")
                    if prompt then 
                        interactWithPrompt(prompt) 
                    else 
                        task.wait(0.3) 
                    end
                    task.wait(0.05)
                end
            end)
        end
    })

    -- 4. สวิตช์ลูปฟาร์ม Royal Treasure (ตัวซ่อนลึกพิกัดติดลบที่เพิ่มใหม่)
    MainTab:AddToggle("RoyalTreasureLoop", {
        Title = "Auto Farm: Royal Treasure",
        Default = false,
        Callback = function(Value)
            Flags.RoyalTreasure = Value
            task.spawn(function()
                while Flags.RoyalTreasure do
                    local prompt = findPromptDynamic("RuinsHuge1", "Royal Treasure.ProximityPrompt")
                    if prompt then 
                        interactWithPrompt(prompt) 
                    else 
                        task.wait(0.3) 
                    end
                    task.wait(0.05)
                end
            end)
        end
    })
else
    warn("❌ By.HxHDDD: ไม่พบแท็บหน้าต่างหลักของ Fuel Library ผ่านตัวแปร _G.HxHDDD_MainTab")
end
