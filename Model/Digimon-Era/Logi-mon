-- [[ 🛑 โซนที่ 1.5: ตรรกะฟังก์ชันวาร์ปและกดรีโมทอัตโนมัติ (เวอร์ชันรองรับมือถือ) 🛑 ]]

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ฟังก์ชันแกนหลักสำหรับวาร์ปและสั่งกด ProximityPrompt แบบเซฟเครื่องมือถือ
local function interactWithPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local targetPart = prompt.Parent:IsA("Model") and prompt.Parent.PrimaryPart or prompt.Parent
    
    if targetPart and targetPart:IsA("BasePart") then
        -- 1. วาร์ปตัวละครเข้าไปประชิด
        rootPart.CFrame = targetPart.CFrame * CFrame.new(0, 2, 0)
        
        -- ดีเลย์ 0.2 วินาทีเพื่อให้โทรศัพท์ไม่แรงโหลดฉาก/วัตถุรอบๆ ทันก่อนกด
        task.wait(0.2) 
        
        local originalRequiresLineOfSight = prompt.RequiresLineOfSight
        local originalMaxDistance = prompt.MaxActivationDistance
        
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 9999
        
        -- 2. สั่งเริ่มกดค้างไว้ตามเวลาของไอเทมนั้นๆ
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
        
        -- คืนค่าดั้งเดิม
        prompt.RequiresLineOfSight = originalRequiresLineOfSight
        prompt.MaxActivationDistance = originalMaxDistance
        
        -- ดีเลย์อีก 0.2 วินาทีหลังเก็บเสร็จ เพื่อให้ระบบเซิร์ฟเวอร์บันทึกข้อมูลและโหลดแอนิเมชันทัน
        task.wait(0.2)
    end
end

-- ฟังก์ชันค้นหาวัตถุตามโครงสร้าง Path
local function getPromptFromPath(folderName, objectName, subPath)
    local gameMap = workspace:FindFirstChild("GameMap")
    if not gameMap then return nil end
    
    local zoneFolder = gameMap:FindFirstChild(folderName)
    if not zoneFolder then return nil end
    
    local mainObj = zoneFolder:FindFirstChild(objectName)
    if not mainObj then return nil end
    
    local prompt = mainObj
    for segment in string.gmatch(config or subPath, "[^%.]+") do
        prompt = prompt and prompt:FindFirstChild(segment)
    end
    return prompt
end

-- ตัวแปรเก็บสถานะการเปิด-ปิดลูปของแต่ละหัวข้อ
