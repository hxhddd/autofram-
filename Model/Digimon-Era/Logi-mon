-- [[ 🛑 โซนที่ 1.9: วนลูปรอจนกว่าหน้าต่าง UI หน้าบ้านจะโหลดเซ็ตค่าเสร็จ By.HxHDDD 🛑 ]]

-- เปลี่ยนมาใช้ตัวแปรแชร์ร่วมแกนหลักเดียวกัน เพื่อดึงข้อมูลมาแสดงปุ่มทันที
repeat task.wait(0.5) until _G.HxHDDD_MainTab

local MainTab = _G.HxHDDD_MainTab


-- [[ 🛑 โซนที่ 2: โครงสร้างการสร้างปุ่ม Toggle ลูปอัตโนมัติ ลิงก์เข้ากับ UI 🛑 ]]

-- ตัวแปรเก็บสถานะเปิด/ปิดบอทของแต่ละหัวข้อ
local Flags = {
    DarkTower = false,
    StandardTreasure = false,
    Carrot = false
}

if MainTab then
    -- 1. สวิตช์ลูปฟาร์ม Dark Tower (กวาดหาทุกโฟลเดอร์ตัวเลข)
    MainTab:AddToggle("DarkTowerLoop", {
        Title = "Auto Farm: Dark Tower",
        Default = false,
        Callback = function(Value)
            Flags.DarkTower = Value
            task.spawn(function()
                while Flags.DarkTower do
                    local prompt = findPromptDynamic("Dark Tower", "TriggerPart.ProximityPrompt")
                    if prompt then 
                        interactWithPrompt(prompt) 
                    else 
                        task.wait(0.5) 
                    end
                    task.wait(0.1)
                end
            end)
        end
    })

    -- 2. สวิตช์ลูปฟาร์ม Standard Treasure (กวาดหาทุกโฟลเดอร์ตัวเลข)
    MainTab:AddToggle("StandardTreasureLoop", {
        Title = "Auto Farm: Standard Treasure",
        Default = false,
        Callback = function(Value)
            Flags.StandardTreasure = Value
            task.spawn(function()
                while Flags.StandardTreasure do
                    local prompt = findPromptDynamic("Ruins1", "Standard Treasure.ProximityPrompt")
                    if prompt then 
                        interactWithPrompt(prompt) 
                    else 
                        task.wait(0.5) 
                    end
                    task.wait(0.1)
                end
            end)
        end
    })

    -- 3. สวิตช์ลูปฟาร์ม Carrot (กวาดหาทุกโฟลเดอร์ตัวเลข)
    MainTab:AddToggle("CarrotLoop", {
        Title = "Auto Farm: Carrot",
        Default = false,
        Callback = function(Value)
            Flags.Carrot = Value
            task.spawn(function()
                while Flags.Carrot do
                    local prompt = findPromptDynamic("Carrot", "Carrot.ProximityPrompt")
                    if prompt then 
                        interactWithPrompt(prompt) 
                    else 
                        task.wait(0.5) 
                    end
                    task.wait(0.1)
                end
            end)
        end
    })
else
    warn("❌ By.HxHDDD: ไม่พบแท็บหน้าต่างหลักของ Fuel Library ผ่านตัวแปร _G.HxHDDD_MainTab")
end
