-- [[ 🛑 โซนที่ 2: โครงสร้างการสร้างปุ่ม Toggle ลูปอัตโนมัติ ลิงก์เข้ากับ Fluent UI 🛑 ]]

-- 1. สวิตช์ลูปฟาร์ม Dark Tower
Tabs.Main:AddToggle("DarkTowerLoop", {
    Title = "Auto Farm: Dark Tower",
    Default = false,
    Callback = function(Value)
        Flags.DarkTower = Value
        
        -- สั่งให้ทำงานเป็นลูปเมื่อเปิดสวิตช์ (True)
        task.spawn(function()
            while Flags.DarkTower do
                local prompt = getPromptFromPath("11_9", "Dark Tower", "TriggerPart.ProximityPrompt")
                if prompt then
                    interactWithPrompt(prompt)
                else
                    -- ถ้าหาไม่เจอ ให้เว้นระยะแป๊บหนึ่งแล้วค่อยหาใหม่ (ป้องกันโค้ดรันไวเกินไปจนเกมค้าง)
                    task.wait(0.5) 
                end
                task.wait(0.1)
            end
        end)
    end
})

