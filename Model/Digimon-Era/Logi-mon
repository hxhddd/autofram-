-- หมายเหตุ: ปรับตัวแปรหน้าบ้านของคุณให้ส่งค่าแท็บมาที่ Tabs.Main หรือเปลี่ยนตรงนี้ให้ตรงกับชื่อตัวแปรแท็บหน้าบ้าน

if Tabs and Tabs.Main then
    -- 1. สวิตช์ลูปฟาร์ม Dark Tower
    Tabs.Main:AddToggle("DarkTowerLoop", {
        Title = "Auto Farm: Dark Tower",
        Default = false,
        Callback = function(Value)
            Flags.DarkTower = Value
            task.spawn(function()
                while Flags.DarkTower do
                    local prompt = getPromptFromPath("11_9", "Dark Tower", "TriggerPart.ProximityPrompt")
                    if prompt then interactWithPrompt(prompt) else task.wait(0.5) end
                    task.wait(0.1)
                end
            end)
        end
    })

    -- 2. สวิตช์ลูปฟาร์ม Standard Treasure (Ruins1)
    Tabs.Main:AddToggle("StandardTreasureLoop", {
        Title = "Auto Farm: Standard Treasure",
        Default = false,
        Callback = function(Value)
            Flags.StandardTreasure = Value
            task.spawn(function()
                while Flags.StandardTreasure do
