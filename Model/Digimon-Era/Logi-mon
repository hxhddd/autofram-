-- [[ 🛑 โซนที่ 1: ตรรกะฟังก์ชันวาร์ป + ระบบยิงรีโมทพื้นหลัง CollectEvent (รองรับพิกัดติดลบ + คูลดาวน์ 3 นาที) 🛑 ]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- ลิงก์ตรงเข้าสู่ Remote Event สำหรับสั่งเก็บไอเทมของตัวเกม
local CollectEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("CollectEvent")

-- ตารางคูลดาวน์ 3 นาที ป้องกันการวนซ้ำจุดเดิมที่เพิ่งเก็บไป
local Cooldowns = {}

-- ฟังก์ชันพิเศษ: ค้นหาและรัวรีโมทเก็บไอเทมทุกชิ้นรอบตัวทันที (ทำงานเป็นเบื้องหลัง)
local function fireCollectEventAroundPlayer()
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    -- ค้นหาอ็อบเจกต์รอบตัวในระยะ 15 Studs เพื่อส่งยิงเซิร์ฟเวอร์โดยตรง
    for _, obj in ipairs(workspace:GetDescendants()) do
        -- ตรวจสอบเงื่อนไขว่าวัตถุมีตำแหน่งและอยู่ใกล้ตัวละครในระยะประชิด
        if obj:IsA("BasePart") and (obj.Position - rootPart.Position).Magnitude <= 15 then
            -- ยิง Remote เคลียร์ไอเทมทันที ข้ามขั้นตอนการรอโหลด ProximityPrompt
            pcall(function()
                CollectEvent:FireServer(obj)
            end)
        end
    end
end

-- ฟังก์ชันหลักควบคุมการวาร์ปและสั่งกด (ยิงทั้ง Remote บดขยี้ปุ่ม และสั่งยิง Event พื้นหลังคู่ขนาน)
local function interactWithPrompt(prompt)
    if not prompt or not prompt.Parent then return end
    
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local targetPart = prompt.Parent:IsA("Model") and prompt.Parent.PrimaryPart or prompt.Parent
    
    if targetPart and targetPart:IsA("BasePart") then
        local itemKey = targetPart.Position
        
        -- 1. วาร์ปกระโดดเข้าประชิดจุดวัตถุเป้าหมาย
        rootPart.CFrame = targetPart.CFrame * CFrame.new(0, 2, 0)
        task.wait(0.1) -- ใช้ดีเลย์สั้นลงเพราะมีระบบยิงรีโมทเคลียร์พื้นหลังมารับช่วงต่อแล้ว
        
        -- 🔥 [ระบบเสริมความไว]: สั่งยิงรีโมทเก็บของรอบตัวทันทีในพื้นหลัง ไม่ต้องง้อปุ่มโผล่!
        task.spawn(fireCollectEventAroundPlayer)
        
        -- 2. สั่งกดปุ่มผ่าน fireproximityprompt คู่ขนานกันไป (กันเหนียวสำหรับของบางชิ้นที่ต้องใช้ปุ่ม)
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                fireproximityprompt(prompt, 0)
            end)
        end
        
        -- 3. ลูปรอเช็คจนกว่าของจะสลายตัว (สูงสุดสปีดไว 0.25 วินาที บอทจะได้ไม่ยืนแช่คาที่)
        local timeOut = 0
        while prompt and prompt.Parent and timeOut < 0.25 do
            task.wait(0.05)
            timeOut = timeOut + 0.05
            -- ยิงซ้ำระหว่างรอเพื่อความชัวร์
            task.spawn(fireCollectEventAroundPlayer)
        end
        
        -- บันทึกจำคูลดาวน์พื้นที่นี้ไว้ 3 นาที (180 วินาที) ก่อนสลัดตัวย้ายจุด
        Cooldowns[itemKey] = os.time()
        task.wait(0.02)
    end
end

-- ฟังก์ชันสแกนหาพิกัดพื้นที่แบบ Dynamic รองรับทั้งโซนเลขบวกและเลขติดลบ
local function findPromptDynamic(objectName, subPath)
    local gameMap = workspace:FindFirstChild("GameMap")
    if not gameMap then return nil end
    
    for _, zoneFolder in ipairs(gameMap:GetChildren()) do
        local mainObj = zoneFolder:FindFirstChild(objectName)
        if mainObj then
            -- ดักแกะสลักพิกัดโครงสร้างลงไปหาเป้าหมายหลัก
            local prompt = mainObj
            for segment in string.gmatch(subPath, "[^%.]+") do
                if prompt then
                    prompt = prompt:FindFirstChild(segment)
                else
                    break
                end
            end
            
            -- ปรับปรุงตรรกะใหม่: ถึงแม้ปุ่ม ProximityPrompt จะยังไม่โหลดมา แต่ถ้าเจอโมเดลหลักโผล่มาแล้ว ให้สลัดค่ากลับไปล็อกเป้าได้ทันที!
            if mainObj:IsA("Model") or mainObj:IsA("BasePart") then
                local targetPart = mainObj:IsA("Model") and mainObj.PrimaryPart or mainObj
                if not targetPart then targetPart = mainObj:FindFirstChildWhichIsA("BasePart") end
                
                if targetPart then
                    local itemKey = targetPart.Position
                    
                    -- เช็คระบบเวลาปลดล็อกคูลดาวน์ 3 นาที
                    if Cooldowns[itemKey] then
                        if os.time() - Cooldowns[itemKey] < 180 then
                            continue 
                        else
                            Cooldowns[itemKey] = nil 
                        end
                    end
                    
                    -- ส่งค่ากลับไปรันฟังก์ชันเก็บทันที (กรณีเจอ Prompt ตรงๆ จะทำงานสมบูรณ์ที่สุด)
                    return prompt or targetPart
                end
            end
        end
    end
    return nil
end

-- ตัวแปรเก็บสถานะการทำงานบอท
local Flags = {
    DarkTower = false,
    StandardTreasure = false,
    Carrot = false,
    RoyalTreasure = false
}


