local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local chestBlacklist = {}
local BLACKLIST_TIME = 180 -- 3 นาที

local function isBlacklisted(chestName)
    if chestBlacklist[chestName] and os.time() < chestBlacklist[chestName] then
        return true
    end
    return false
end

local function warpToChest(targetPart)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    
    local distance = (hrp.Position - targetPart.Position).Magnitude
    local speed = 30 -- ความเร็วเซฟโซนตามมาตรฐาน
    local duration = distance / speed
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetPart.CFrame * CFrame.new(0, 3, 0)})
    tween:Play()
    tween.Completed:Wait()
    task.wait(0.2)
    return true
end

local function runChestFarm()
    local chestFolder = workspace:FindFirstChild("RuntimeCache") 
        and workspace.RuntimeCache:FindFirstChild("RuntimeCacheClient") 
        and workspace.RuntimeCache.RuntimeCacheClient:FindFirstChild("Chest")

    if not chestFolder then return end

    for _, chest in ipairs(chestFolder:GetChildren()) do
        if not _G.AutoChestFarm then break end 
        
        local root = chest:FindFirstChild("Root")
        local prompt = root and root:FindFirstChild("Prompt")
        
        if root and prompt and not isBlacklisted(chest.Name) then
            local arrived = warpToChest(root)
            if arrived and _G.AutoChestFarm then
                
                task.spawn(function()
                    fireproximityprompt(prompt)
                end)
                
                local timeout = 0
                while chest:IsDescendantOf(workspace) and _G.AutoChestFarm and timeout < 5 do
                    task.wait(0.1)
                    timeout = timeout + 0.1
                end
                
                chestBlacklist[chest.Name] = os.time() + BLACKLIST_TIME
                task.wait(0.3) 
            end
        end
    end
end

task.spawn(function()
    while true do
        if _G.AutoChestFarm then
            local success, err = pcall(runChestFarm)
            if not success then
                warn("Chest Farm Error: " .. tostring(err))
            end
        end
        task.wait(1)
    end
end)
