-- [[ 🛑 โซนที่ 3: Main Logic & Auto Chest Farm 🛑 ]]

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- ตารางคูลดาวน์ 3 นาที (180 วินาที) และสถานะปุ่ม
local Cooldowns = {}
local AutoChestEnabled = false

-- 1. ฟังก์ชันวาร์ปตัดพิกัดตรงๆ ไปตำแหน่งพิกัดโลกของ Root (Instant Warp)
local function warpToTarget(rootPart)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- วาร์ปตัดพิกัดเข้าจุดกึ่งกลางของกล่องตรงๆ
    hrp.CFrame = rootPart.CFrame
    return true
end

-- 2. ฟังก์ชันหลักในการวาร์ป ยืนรอดักฉากโหลด และรัวปุ่ม E จำนวน 5 ครั้ง
local function interactWithChest(chest, rootPart)
    if not rootPart or not rootPart:IsA("BasePart") then return end
    local itemKey = rootPart.Position
    
    local arrived = warpToTarget(rootPart)
    if arrived then
        -- 🔥 [แก้ปัญหาฉากโหลดไม่ทัน]: ยืนแช่นิ่งรอ 1.5 วินาที เพื่อให้ตัวเกมเคลียร์หน้าจอและโหลดวัตถุเสร็จก่อนกด
        task.wait(1.5)
        
        -- 🔥 [ระบบรัวปุ่มซัพพอร์ต]: รัวกดปุ่ม E ทั้งหมด 5 ครั้ง เพื่อป้องกันปุ่มหลุด/กดไม่ติด
        for i = 1, 5 do
            if not AutoChestEnabled or not chest:IsDescendantOf(workspace) then break end
            
            -- จำลองการกดปุ่ม E (กดลง)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05) -- ดีเลย์สั้นๆ ระหว่างกดลง
            
            -- จำลองการปล่อยปุ่ม E (ยกขึ้น)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            
            -- ใช้ดีเลย์คูลดาวน์เว้นระยะ 0.2 วินาทีต่อครั้งตามสั่ง
            task.wait(0.2)
        end
        
        -- บันทึกจำพิกัดนี้ลงตารางคูลดาวน์ Blacklist ชั่วคราว 3 นาที (180 วินาที)
        Cooldowns[itemKey] = os.time()
        task.wait(0.05)
    end
end

-- 3. ฟังก์ชันสแกนหาพิกัดพื้นที่กล่องในโฟลเดอร์แบบ Dynamic และคัดกรอง Blacklist
local function findChestDynamic()
    local chestFolder = workspace:FindFirstChild("RuntimeCache") 
        and workspace.RuntimeCache:FindFirstChild("RuntimeCacheClient") 
        and workspace.RuntimeCache.RuntimeCacheClient:FindFirstChild("Chest")

    if not chestFolder then return nil, nil end

    for _, chest in ipairs(chestFolder:GetChildren()) do
        local root = chest:FindFirstChild("Root")
        
        if root and root:IsA("BasePart") then
            local itemKey = root.Position
            
            -- ตรวจสอบประวัติระบบเวลาปลดล็อกคูลดาวน์ 3 นาที
            if Cooldowns[itemKey] then
                if os.time() - Cooldowns[itemKey] < 180 then
                    continue 
                else
                    Cooldowns[itemKey] = nil 
                end
            end
            
            return chest, root
        end
    end
    return nil, nil
end

-- 4. รวบตรรกะสร้างปุ่มสวิตช์และลูปการทำงานหลักไว้ในกระทู้คู่ขนานเดียวกัน
task.spawn(function()
    -- วนลูปรอจนกว่าหน้าต่าง UI หน้าบ้านจะโหลดเซ็ตค่าเสร็จสมบูรณ์
    while not _G.HxHDDD_MainTab do 
        task.wait(0.5) 
    end
    local MainTab = _G.HxHDDD_MainTab

    -- สร้างปุ่ม Toggle เสียบปลั๊กรวมเข้ากับหน้าต่างหลักทันที
    MainTab:AddToggle("AutoChestLoop", {
        Title = "Auto Farm: Open Chest",
        Description = "วาร์ปรอโหลดฉาก 1.5 วิ + รัวปุ่ม E 5 ครั้ง คูลดาวน์จุดเดิม 3 นาที (By.HxHDDD)",
        Default = false,
        Callback = function(Value)
            AutoChestEnabled = Value
            
            if AutoChestEnabled then
                task.spawn(function()
                    while AutoChestEnabled do
                        local chest, root = findChestDynamic()
                        if chest and root then 
                            interactWithChest(chest, root) 
                        else 
                            task.wait(0.5) -- พักตรวจสแกนสั้นๆ หากยังไม่มีกล่องใหม่เกิดในระบบ
                        end
                        task.wait(0.02)
                    end
                end)
            end
        end
    })
end)
