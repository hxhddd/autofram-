-- [[ 🛑 โซนที่ 3: Main Logic & Auto Chest Farm 🛑 ]]

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ตารางคูลดาวน์ 3 นาที (180 วินาที) และสถานะปุ่ม
local Cooldowns = {}
local AutoChestEnabled = false

-- 1. ฟังก์ชันวาร์ปตัดพิกัดตรงๆ ไปยัง Layout ทันที (Instant Warp)
local function warpToTarget(targetPart)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- วาร์ปตัดพิกัดไปตำแหน่ง Layout ตรงๆ
    hrp.CFrame = targetPart.CFrame
    task.wait(0.1) -- ดีเลย์สั้นๆ ให้ระบบเกมอัปเดตตำแหน่งพิกัดตัวละคร
    return true
end

-- 2. ฟังก์ชันหลักในการเข้าทำกล่อง กดปุ่มปกติ และยืนแช่ 3 วินาที
local function interactWithChest(chest, prompt, layoutPart)
    if not layoutPart or not layoutPart:IsA("BasePart") then return end
    local itemKey = layoutPart.Position
    
    local arrived = warpToTarget(layoutPart)
    if arrived then
        -- สั่งกดปุ่มรูปแบบปกติของเรา
        if prompt and prompt:IsA("ProximityPrompt") then
            pcall(function() 
                fireproximityprompt(prompt) 
            end)
        end
        
        -- เงื่อนไขพิเศษ: สั่งให้ยืนแช่เอาไว้ตรงกล่องหลังกดไปแล้วเป็นเวลา 3 วินาที
        task.wait(3)
        
        -- บันทึกจำคูลดาวน์พื้นที่นี้ไว้ 3 นาที (180 วินาที)
        Cooldowns[itemKey] = os.time()
        task.wait(0.02)
    end
end

-- 3. ฟังก์ชันสแกนหาพิกัดพื้นที่ของ Chest ในโฟลเดอร์แบบเจาะจง Layout
local function findChestDynamic()
    local chestFolder = workspace:FindFirstChild("RuntimeCache") 
        and workspace.RuntimeCache:FindFirstChild("RuntimeCacheClient") 
        and workspace.RuntimeCache.RuntimeCacheClient:FindFirstChild("Chest")

    if not chestFolder then return nil, nil, nil end

    for _, chest in ipairs(chestFolder:GetChildren()) do
        local layout = chest:FindFirstChild("Layout")
        local root = chest:FindFirstChild("Root")
        local prompt = root and root:FindFirstChild("Prompt")
        
        -- ตรวจสอบว่ามี Layout และพิกัดพร้อมให้วาร์ป
        if layout and layout:IsA("BasePart") then
            local itemKey = layout.Position
            
            -- เช็คระบบเวลาปลดล็อกคูลดาวน์ 3 นาที
            if Cooldowns[itemKey] then
                if os.time() - Cooldowns[itemKey] < 180 then
                    continue 
                else
                    Cooldowns[itemKey] = nil 
                end
            end
            
            return chest, prompt, layout
        end
    end
    return nil, nil, nil
end

-- 4. รวบตรรกะสร้างปุ่มสวิตช์และลูปการทำงานหลักไว้ร่วมกัน
task.spawn(function()
    -- วนลูปรอจนกว่าหน้าต่าง UI หน้าบ้านจะโหลดเซ็ตค่าเสร็จ
    while not _G.HxHDDD_MainTab do 
        task.wait(0.5) 
    end
    local MainTab = _G.HxHDDD_MainTab

    -- สร้างปุ่ม Toggle เสียบปลั๊กเข้าไปในระบบทันที
    MainTab:AddToggle("AutoChestLoop", {
        Title = "Auto Farm: Open Chest",
        Description = "วาร์ปตัดพิกัดเข้า Layout ยืนแช่ 3 วิ พร้อมคูลดาวน์เลี่ยงจุดเดิม 3 นาที (By.HxHDDD)",
        Default = false,
        Callback = function(Value)
            AutoChestEnabled = Value
            
            if AutoChestEnabled then
                task.spawn(function()
                    while AutoChestEnabled do
                        local chest, prompt, layout = findChestDynamic()
                        if chest and layout then 
                            interactWithChest(chest, prompt, layout) 
                        else 
                            task.wait(0.3) -- พักสแกนสั้นๆ หากยังไม่มีกล่องใหม่เกิดในโฟลเดอร์
                        end
                        task.wait(0.02)
                    end
                end)
            end
        end
    })
end)
