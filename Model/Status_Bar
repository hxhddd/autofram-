-- [[ 🛑 โซนที่ 2: Status Bar & Background Anti-Cheat 🛑 ]]
-- สร้าง Label หรือ Paragraph บน Fluent UI สำหรับโชว์ค่า
local StatusLabel = Tabs.Main:AddParagraph({
    Title = "📊 Character Status",
    Content = "Loading data..."
})

-- ลูปอัปเดตค่าหน้าจอโชว์ขำๆ แต่แฝงงานจริงหลังบ้าน
task.spawn(function()
    while task.wait(1) do -- อัปเดตทุก 1 วินาที กำลังดีสำหรับมือถือ ไม่แล็ก
        local player = game.Players.LocalPlayer
        if player and player.Character then
            -- 1. ดึงข้อมูลมาโชว์บน GUI ให้ดูมีอะไร (โชว์ไปงั้นแหละ 555)
            local currentLevel = player.DataSlot.Level.Value -- สมมติตำแหน่งค่าในเกม
            local currentMoney = player.DataSlot.Money.Value
            StatusLabel:SetTitle("📊 Lv. " .. tostring(currentLevel) .. " | 💰 " .. tostring(currentMoney))
            
            -- 2. แอบยัดไส้เช็กเกม (Anti-Tamper / Safety Check) แบบเงียบๆ หลังบ้าน
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                -- เช็กความเร็วแอบแฝง ถ้าค่ามันหลุดเกณฑ์ที่ตั้งไว้ก็ให้จัดการตัวเองทันที
                if humanoid.WalkSpeed > 35 then 
                    -- สั่งเตือนหรือตัดไฟระบบฟาร์มป้องกันไอดีปลิวเงียบๆ
                end
            end
        end
    end
end)

-- [[ 🛑 โซนที่ 1: F9 Console Display Monitor 🛑 ]]
-- Project: Event Farm Control v1.0 | Style: By.HxHDDD
-- อธิบาย: ตีกรอบโชว์ Log จาก F9 เอาไว้เลื่อนดูขำๆ เท่ๆ หน้า GUI

local LogService = game:GetService("LogService")

-- 1. สร้างหัวข้อหรือ Tab ใหม่บน UI สำเร็จรูป
local MonitorTab = Window:CreateTab("📊 Monitor")

-- 2. ตีกรอบข้อความยาวๆ เอาไว้โชว์และเลื่อนดู (ใช้ Paragraph คุม)
local LogBox = MonitorTab:AddParagraph({
    Title = "📜 Live Game Console Logs",
    Content = "System initialized...\nWaiting for logs..."
})

-- ตัวแปรเก็บข้อความจำกัดไว้สัก 5 บรรทัดล่าสุด (จะได้ไม่ล้นจอเกินไปและเลื่อนดูได้นิดหน่อยพอดีๆ)
local logHistory = {}

local function UpdateConsoleLog(message, messageType)
    -- ใส่เวลาเข้าไปข้างหน้าข้อความ
    local timestamp = os.date("%X")
    table.insert(logHistory, "[" .. timestamp .. "] " .. message)
    
    -- ถ้าเกิน 5 บรรทัดให้ตัดบรรทัดเก่าสุดออก จะได้ไม่กินแรมมือถือ
    if #logHistory > 5 then
        table.remove(logHistory, 1)
    end
    
    -- รวมร่างข้อความแล้วพ่นลงกรอบ UI (เปิดโอกาสให้ม้วนพับและเลื่อนดูได้)
    LogBox:SetContent(table.concat(logHistory, "\n"))
end

-- เชื่อมต่อดักฟัง Log F9 เข้าสู่กรอบมอนิเตอร์ของเรา
LogService.MessageOut:Connect(UpdateConsoleLog)
