-- [[ 🛑 โซนที่ 1: Main Logic & Auto Lake Farm 🛑 ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local VerdantRemotes = ReplicatedStorage:WaitForChild("VerdantRemotes")
local BucketUsed = VerdantRemotes:WaitForChild("VDT_Bucket.Used")
local BucketPoured = VerdantRemotes:WaitForChild("VDT_Bucket.Poured")
local TokensTake = VerdantRemotes:WaitForChild("VDT_Tokens.Take")

-- ตัวแปรควบคุมสถานะปุ่มสลับ (แยกสวิตช์ทำงานอิสระพร้อมกันได้)
local AutoBucketUsed = false
local AutoBucketPoured = false
local AutoTokensTake = false

-- รวบตรรกะสร้างปุ่มสวิตช์และลูปการทำงานหลักไว้ในกระทู้คู่ขนานเดียวกัน ตามมาตรฐานหน้าบ้านสำเร็จรูป
task.spawn(function()
    -- วนลูปรอจนกว่าหน้าต่าง UI หน้าบ้านจะโหลดเซ็ตค่าเสร็จสมบูรณ์
    while not _G.HxHDDD_MainTab do 
        task.wait(0.5) 
    end
    local MainTab = _G.HxHDDD_MainTab

    -- ปุ่มที่ 1: Auto Use Bucket
    MainTab:AddToggle("AutoBucketUsedLoop", {
        Title = "Auto Use Bucket",
        Description = "ส่งคำสั่งใช้งานถังน้ำอัตโนมัติเป็นลูปแยกอิสระ (By.HxHDDD)",
        Default = false,
        Callback = function(Value)
            AutoBucketUsed = Value
            
            if AutoBucketUsed then
                task.spawn(function()
                    while AutoBucketUsed do
                        pcall(function()
                            BucketUsed:FireServer()
                        end)
                        task.wait(0.1) -- เว้นระยะดีเลย์สั้นๆ ป้องกันโอเวอร์โหลด
                    end
                end)
            end
        end
    })

    -- ปุ่มที่ 2: Auto Pour Bucket
    MainTab:AddToggle("AutoBucketPouredLoop", {
        Title = "Auto Pour Bucket",
        Description = "ส่งคำสั่งเทน้ำใส่ท่อระบายน้ำจุดเช็คพอยท์ 1 อัตโนมัติ (By.HxHDDD)",
        Default = false,
        Callback = function(Value)
            AutoBucketPoured = Value
            
            if AutoBucketPoured then
                task.spawn(function()
                    while AutoBucketPoured do
                        pcall(function()
                            local args = {
                                Workspace:WaitForChild("Scripted"):WaitForChild("CheckpointParts"):WaitForChild("1"):WaitForChild("Drain"):WaitForChild("Scripted"):WaitForChild("ProximityPosition"):WaitForChild("ProximityPrompt")
                            }
                            BucketPoured:FireServer(unpack(args))
                        end)
                        task.wait(0.1)
                    end
                end)
            end
        end
    })

    -- ปุ่มที่ 3: Auto Take Tokens
    MainTab:AddToggle("AutoTokensTakeLoop", {
        Title = "Auto Take Tokens",
        Description = "ส่งคำสั่งเก็ปรับโทเคนจากจุดเช็คพอยท์ 1 อัตโนมัติ (By.HxHDDD)",
        Default = false,
        Callback = function(Value)
            AutoTokensTake = Value
            
            if AutoTokensTake then
                task.spawn(function()
                    while AutoTokensTake do
                        pcall(function()
                            local args = {
                                Workspace:WaitForChild("Scripted"):WaitForChild("CheckpointParts"):WaitForChild("1"):WaitForChild("Drain"):WaitForChild("Scripted"):WaitForChild("ProximityPosition"):WaitForChild("ProximityPrompt")
                            }
                            TokensTake:FireServer(unpack(args))
                        end)
                        task.wait(0.1)
                    end
                end)
            end
        end
    })
end)
