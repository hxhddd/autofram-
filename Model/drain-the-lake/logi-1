-- [[ 🛑 โซนที่ 1: Main Logic & Auto Lake Farm 🛑 ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local VerdantRemotes = ReplicatedStorage:WaitForChild("VerdantRemotes")
local BucketUsed = VerdantRemotes:WaitForChild("VDT_Bucket.Used")
local BucketPoured = VerdantRemotes:WaitForChild("VDT_Bucket.Poured")
local TokensTake = VerdantRemotes:WaitForChild("VDT_Tokens.Take")

-- ตัวแปรควบคุมสถานะปุ่มสลับ (แยกสวิตช์ทำงานอิสระพร้อมกันได้)
local AutoBucketUsed = false
local AutoBucketPoured = false
local AutoTokensTake = false

-- รวบตรรกะสร้างปุ่มสวิตช์และลูปการทำงานหลักไว้ในกระทู้คู่ขนานเดียวกัน ตามมาตรฐานหน้าบ้านสำเร็จรูป
task.spawn(function()
    -- วนลูปรอจนกว่าหน้าต่าง UI หน้าบ้านจะโหลดเซ็ตค่าเสร็จสมบูรณ์
    while not _G.HxHDDD_MainTab do 
        task.wait(0.5) 
    end
    local MainTab = _G.HxHDDD_MainTab

    -- ปุ่มที่ 1: Auto Use Bucket
    MainTab:AddToggle("AutoBucketUsedLoop", {
        Title = "Auto Use Bucket",
        Description = "ส่งคำสั่งใช้งานถังน้ำอัตโนมัติเป็นลูปแยกอิสระ (By.HxHDDD)",
        Default = false,
        Callback = function(Value)
            AutoBucketUsed = Value
            
            if AutoBucketUsed then
                task.spawn(function()
                    while AutoBucketUsed do
                        pcall(function()
                            BucketUsed:FireServer()
                        end)
                        task.wait(0.1) -- เว้นระยะดีเลย์สั้นๆ ป้องกันโอเวอร์โหลด
                    end
                end)
            end
        end
    })

        -- ปุ่มที่ 2: Auto Pour Bucket (เวอร์ชันแก้ทางโครงสร้างมั่ว - สแกนหาวัตถุ Drain ที่ใกล้ที่สุดโดยตรง)
    MainTab:AddToggle("AutoBucketPouredLoop", {
        Title = "Auto Pour Bucket",
        Description = "เทน้ำใส่ท่อระบายน้ำที่ใกล้ที่สุดโดยคำนวณพิกัดระยะทางจริง (By.HxHDDD)",
        Default = false,
        Callback = function(Value)
            AutoBucketPoured = Value
            
            if AutoBucketPoured then
                task.spawn(function()
                    while AutoBucketPoured do
                        pcall(function()
                            -- 1. ดึงตำแหน่งตัวละครของเรา ณ ปัจจุบัน
                            local character = game:GetService("Players").LocalPlayer.Character
                            local hrp = character and character:FindFirstChild("HumanoidRootPart")
                            
                            if hrp then
                                local closestPrompt = nil
                                local shortestDistance = math.huge
                                
                                -- 2. วนลูปค้นหาวัตถุชื่อ "Drain" ทั้งหมดที่มีอยู่ใน workspace โดยตรง
                                -- ไม่สนใจว่าจะอยู่ในโฟลเดอร์ไหน หรือเรียงเลขหรือไม่
                                for _, object in ipairs(Workspace:GetDescendants()) do
                                    if object.Name == "Drain" and (object:IsA("Model") or object:IsA("Folder")) then
                                        -- เจาะลึกหา ProximityPrompt ด้านในสุดตามโครงสร้างจริงใน Dex
                                        local prompt = object:FindFirstChild("Scripted")
                                            and object.Scripted:FindFirstChild("ProximityPosition")
                                            and object.Scripted.ProximityPosition:FindFirstChild("ProximityPrompt")
                                            
                                        if prompt then
                                            -- คำนวณระยะห่างทางกายภาพจริงระหว่างตัวเรากับท่อระบายน้ำ (.Magnitude)
                                            local distance = (hrp.Position - prompt.Parent.Position).Magnitude
                                            if distance < shortestDistance then
                                                shortestDistance = distance
                                                closestPrompt = prompt
                                            end
                                        end
                                    end
                                end
                                
                                -- 3. เมื่อเจอจุด Drain ที่ใกล้ตัวเราที่สุดแล้ว ให้ยิงรีโมทไปที่จุดนั้นทันที
                                if closestPrompt then
                                    local args = { closestPrompt }
                                    BucketPoured:FireServer(unpack(args))
                                end
                            end
                        end)
                        task.wait(0.1) -- ดีเลย์วนลูปฟาร์มสั้นๆ ป้องกันเกมแลค
                    end
                end)
            end
        end
    })



    -- ปุ่มที่ 3: Auto Take Tokens
    MainTab:AddToggle("AutoTokensTakeLoop", {
        Title = "Auto Take Tokens",
        Description = "ส่งคำสั่งเก็ปรับโทเคนจากจุดเช็คพอยท์ 1 อัตโนมัติ (By.HxHDDD)",
        Default = false,
        Callback = function(Value)
            AutoTokensTake = Value
            
            if AutoTokensTake then
                task.spawn(function()
                    while AutoTokensTake do
                        pcall(function()
                            local args = {
                                Workspace:WaitForChild("Scripted"):WaitForChild("CheckpointParts"):WaitForChild("1"):WaitForChild("Drain"):WaitForChild("Scripted"):WaitForChild("ProximityPosition"):WaitForChild("ProximityPrompt")
                            }
                            TokensTake:FireServer(unpack(args))
                        end)
                        task.wait(0.1)
                    end
                end)
            end
        end
    })
end)
