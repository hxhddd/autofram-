-- [[ 🛑 โซนที่ 2: Logic ฟาร์มหลักแบบฟังก์ชันคลีน (By.HxHDDD v3.1) 🛑 ]]
local ProximityPromptService = game:GetService("ProximityPromptService")

-- ค่าคอนฟิกสำหรับกรองเป้าหมาย
local Keywords = { "collect", "take", "harvest" }
local TargetNames = { "Tree", "Egg", "Food", "Mob", "Client", "FoodTreeCheck", "Eggs" }

-- ฟังก์ชันตรวจสอบความถูกต้องของเงื่อนไข
local function ShouldInteract(prompt)
    if not prompt or not prompt.Enabled then return false end
    
    local parent = prompt.Parent
    if not parent then return false end
    
    local parentName = parent.Name
    local actionText = prompt.ActionText:lower()
    
    for _, target in ipairs(TargetNames) do
        if parentName:find(target) or parent:FindFirstAncestor(target) then
            return true
        end
    end
    
    for _, keyword in ipairs(Keywords) do
        if actionText:find(keyword) then
            return true
        end
    end
    
    return false
end

-- ส่งฟังก์ชันลูปหลักออกไปทำงานเมื่อถูกเรียกใช้งาน
return function()
    print("🚀 [By.HxHDDD] AutoCollector เริ่มทำงานระบบกวาดล้างแล้ว")
    
    while _G.AutoFarmRunning do
        local found = false
        local allPrompts = ProximityPromptService:GetProximityPrompts()
        
        for _, prompt in ipairs(allPrompts) do
            if ShouldInteract(prompt) then
                if not _G.AutoFarmRunning then break end -- หยุดทันทีถ้าสวิตช์ปิดกลางคัน
                pcall(function()
                    fireproximityprompt(prompt, 0)
                end)
                found = true
            end
        end
        
        if not found then
            task.wait(0.5)
        else
            task.wait(0.1)
        end
    end
    
    print("⛔ [By.HxHDDD] AutoCollector หยุดทำงาน")
end
